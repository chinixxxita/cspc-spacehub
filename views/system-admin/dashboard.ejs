<div class="system-admin-page">
<div class="page-header">
  <div>
    <p class="eyebrow">CAMPUS-WIDE CONTROL</p>
    <h1>System Administration</h1>
    <p class="muted">Create and manage the College Administrator account for each CSPC college.</p>
  </div>
</div>

<% if (resetResult) { %>
  <div class="card" style="margin-bottom:1.25rem;border:1px solid #d6a84f" role="status">
    <div class="card-body">
      <h2><%= resetResult.notice %></h2>
      <p><strong><%= resetResult.full_name %></strong> · <%= resetResult.school_id %></p>
      <p style="font-size:1.1rem"><strong>Temporary password:</strong> <code><%= resetResult.password %></code></p>
      <p class="muted">Copy this password now. It will not be displayed again.</p>
    </div>
  </div>
<% } %>

<div class="card" style="margin-bottom:1.25rem">
  <div class="card-body">
    <h2>College Administrator accounts</h2>
    <p class="muted">Each college has one designated College Administrator. Accounts are assigned to exactly one college. Deactivated accounts retain their college slot and can be reactivated.</p>
    <div class="table-responsive system-admin-table-wrap">
      <table class="table system-admin-table">
        <thead><tr><th>College</th><th>Administrator</th><th>Account status</th><th>Actions</th></tr></thead>
        <tbody>
          <% colleges.forEach(college => { %>
            <tr>
              <td><strong><%= college.code %></strong><br><small><%= college.name %></small></td>
              <td>
                <% if (college.administrator_id) { %>
                  <strong><%= college.full_name %></strong><br>
                  <small><%= college.school_id %> · <%= college.email %></small>
                  <% if (college.must_change_password) { %><br><small class="muted">Password change required</small><% } %>
                <% } else { %><span class="muted">No administrator assigned</span><% } %>
              </td>
              <td>
                <% if (college.administrator_id) { %>
                  <span class="badge <%= college.administrator_status === 'Active' ? 'approved' : 'cancelled' %>"><%= college.administrator_status %></span>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td class="system-admin-actions">
                <% if (!college.administrator_id) { %>
                  <button class="button-link-dark" type="button" onclick="document.getElementById('create-admin-<%= college.id %>').showModal()">Create account</button>
                  <dialog class="system-admin-dialog" id="create-admin-<%= college.id %>" aria-labelledby="create-admin-title-<%= college.id %>">
                    <div class="system-admin-dialog-header">
                      <div>
                        <p class="eyebrow">COLLEGE ACCOUNT</p>
                        <h2 id="create-admin-title-<%= college.id %>">Create College Administrator</h2>
                        <p class="muted">Assign an administrator to <strong><%= college.code %></strong>.</p>
                      </div>
                      <button class="system-admin-dialog-close" type="button" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
                    </div>
                    <form class="system-admin-modal-form" action="/system-admin/college-admins" method="post">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <input type="hidden" name="college_id" value="<%= college.id %>">
                      <label for="school-id-<%= college.id %>">School ID <span aria-hidden="true">*</span></label>
                      <input id="school-id-<%= college.id %>" name="school_id" maxlength="30" autocomplete="off" required>
                      <label for="full-name-<%= college.id %>">Full name <span aria-hidden="true">*</span></label>
                      <input id="full-name-<%= college.id %>" name="full_name" maxlength="150" autocomplete="name" required>
                      <label for="email-<%= college.id %>">CSPC email <span aria-hidden="true">*</span></label>
                      <input id="email-<%= college.id %>" type="email" name="email" placeholder="name@cspc.edu.ph" autocomplete="email" required>
                      <div class="system-admin-modal-actions">
                        <button class="secondary" type="button" onclick="this.closest('dialog').close()">Cancel</button>
                        <button class="primary" type="submit">Create account</button>
                      </div>
                    </form>
                  </dialog>
                <% } else { %>
                  <button class="button-link-dark" type="button" onclick="document.getElementById('manage-admin-<%= college.id %>').showModal()">Manage</button>
                  <dialog class="system-admin-dialog" id="manage-admin-<%= college.id %>" aria-labelledby="manage-admin-title-<%= college.id %>">
                    <div class="system-admin-dialog-header">
                      <div>
                        <p class="eyebrow">COLLEGE ACCOUNT</p>
                        <h2 id="manage-admin-title-<%= college.id %>">Manage Administrator</h2>
                        <p class="muted"><strong><%= college.code %></strong> · <%= college.full_name %></p>
                      </div>
                      <button class="system-admin-dialog-close" type="button" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
                    </div>
                    <form class="system-admin-modal-form" action="/system-admin/college-admins/<%= college.administrator_id %>/update" method="post">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <label for="assigned-college-<%= college.id %>">Assigned college <span aria-hidden="true">*</span></label>
                      <select id="assigned-college-<%= college.id %>" name="college_id" required>
                        <% colleges.forEach(option => { %><option value="<%= option.id %>" <%= option.id === college.id ? 'selected' : '' %> <%= option.administrator_id && option.id !== college.id ? 'disabled' : '' %>><%= option.code %></option><% }) %>
                      </select>
                      <label for="edit-name-<%= college.id %>">Full name <span aria-hidden="true">*</span></label>
                      <input id="edit-name-<%= college.id %>" name="full_name" maxlength="150" value="<%= college.full_name %>" required>
                      <label for="edit-email-<%= college.id %>">CSPC email <span aria-hidden="true">*</span></label>
                      <input id="edit-email-<%= college.id %>" type="email" name="email" value="<%= college.email %>" required>
                      <div class="system-admin-modal-actions">
                        <button class="secondary" type="button" onclick="this.closest('dialog').close()">Cancel</button>
                        <button class="primary" type="submit">Save changes</button>
                      </div>
                    </form>
                    <div class="system-admin-account-actions">
                      <form action="/system-admin/college-admins/<%= college.administrator_id %>/status" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                        <input type="hidden" name="status" value="<%= college.administrator_status === 'Active' ? 'Inactive' : 'Active' %>">
                        <button class="danger-outline" type="submit" onclick="return confirm('Change this administrator account status?')"><%= college.administrator_status === 'Active' ? 'Deactivate account' : 'Reactivate account' %></button>
                      </form>
                      <form action="/system-admin/college-admins/<%= college.administrator_id %>/reset-password" method="post" onsubmit="return confirm('Generate a new temporary password? The current password will stop working.');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                        <button class="danger-outline" type="submit">Reset password</button>
                      </form>
                    </div>
                  </dialog>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h2>Access boundaries</h2>
    <ul>
      <li>The System Administrator manages College Administrator accounts across all colleges.</li>
      <li>Each College Administrator can access only their assigned college's administration area.</li>
      <li>College Administrators cannot create, edit, deactivate, or reset other administrator accounts.</li>
      <li>Creation, profile changes, status changes, and password resets are recorded in the audit log.</li>
      <li>New and reset passwords are temporary and require a change at next login.</li>
    </ul>
  </div>
</div>
</div>
