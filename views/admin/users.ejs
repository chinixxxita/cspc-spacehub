<section>
  <div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>Manage Users</h1><p>View account roles and control account status for <%= adminCollege.code %> users.</p></div></div>
  <% if (typeof resetResult !== 'undefined' && resetResult) { %>
    <div class="card notice" role="alert"><strong>Temporary password for <%= resetResult.full_name %> (<%= resetResult.school_id %>)</strong>
      <p><code style="font-size:1.2em;user-select:all"><%= resetResult.password %></code></p>
      <p class="muted">Shown only once. Give it to the user privately. They must choose a new password at their next login, and any open sessions were signed out.</p></div>
  <% } %>
  <div class="card"><div class="table-wrap"><table data-table><thead><tr><th>User</th><th>School ID</th><th>Role</th><th>Status</th><th>Created</th><th>Action</th></tr></thead><tbody>
    <% users.forEach(user => { %><tr><td><strong><%= user.full_name %></strong><br><small><%= user.email %></small></td><td><%= user.school_id %></td><td><span class="facility-type"><%= user.role %></span></td><td><span class="badge <%= user.status.toLowerCase() %>"><%= user.status %></span></td><td><%= formatDay(user.created_at) %></td><td><% if (user.id === currentUser.id) { %><span class="muted">Current account</span><% } else { %><form class="inline-form" action="/admin/users/<%= user.id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><select name="status" onchange="this.form.submit()"><option value="">Change</option><option>Active</option><option>Inactive</option><option>Pending</option></select></form><% if (user.role !== 'admin') { %><form class="inline-form" action="/admin/users/<%= user.id %>/reset-password" method="post" onsubmit="return confirm('Reset this user\'s password? Their sessions will be signed out.');"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="danger-outline" type="submit">Reset password</button></form><% } %><% } %></td></tr><% }) %>
  </tbody></table></div></div>
</section>
