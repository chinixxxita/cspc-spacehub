<section class="facilities-page">
  <div class="page-heading facilities-heading">
    <div>
      <h1>Rooms &amp; Laboratories</h1>
      <p>Browse facilities by college, type, or capacity.</p>
    </div>
  </div>

  <div class="facility-toolbar card" role="search">
    <div class="facility-control facility-search-control">
      <label for="facilitySearch">Search</label>
      <input id="facilitySearch" type="search" placeholder="Facility, building, or college" autocomplete="off">
    </div>
    <div class="facility-control">
      <label for="collegeFilter">College / Department</label>
      <select id="collegeFilter">
        <option value="all">All colleges</option>
        <% [...new Map(rooms.map(r => [r.college_code, r.college_name])).entries()].sort((a,b) => a[0].localeCompare(b[0])).forEach(([code, name]) => { %>
          <option value="<%= code %>"><%= code %> — <%= name %></option>
        <% }) %>
      </select>
    </div>
    <div class="facility-control">
      <label for="facilitySort">Sort by</label>
      <select id="facilitySort">
        <option value="name">Facility name (A–Z)</option>
        <option value="college">College (A–Z)</option>
        <option value="capacity-desc">Capacity (highest)</option>
        <option value="capacity-asc">Capacity (lowest)</option>
        <option value="type">Facility type</option>
      </select>
    </div>
    <p class="facility-results" id="facilityResults" aria-live="polite"><%= rooms.length %> facilities</p>
  </div>

  <% if (!rooms.length) { %>
    <div class="empty-state card"><h2>No facilities available</h2><p>Contact your college administrator to have facilities added.</p></div>
  <% } %>

  <div class="room-grid facilities-grid" id="facilityGrid">
    <% rooms.forEach(room => { %>
      <article class="room-card facility-card"
        data-college="<%= room.college_code %>"
        data-search="<%= `${room.name} ${room.type} ${room.building || ''} ${room.college_name} ${room.college_code}`.toLowerCase() %>"
        data-name="<%= room.name %>"
        data-college-name="<%= room.college_name %>"
        data-type="<%= room.type %>"
        data-capacity="<%= Number(room.capacity) || 0 %>">
        <div class="facility-card-top">
          <span class="facility-type"><%= room.type %></span>
          <span class="badge <%= String(room.status || '').toLowerCase() %>"><%= room.status %></span>
        </div>
        <div class="facility-college"><strong><%= room.college_code %></strong><span><%= room.college_name %></span></div>
        <h2><%= room.name %></h2>
        <% if (room.description) { %><p><%= room.description %></p><% } %>
        <div class="room-meta">
          <span><strong><%= room.capacity %></strong> seats</span>
          <span><%= room.air_conditioned ? 'Air-conditioned' : 'No air conditioning' %></span>
          <span><%= room.has_computers ? `${room.computer_count} computers` : 'No computers listed' %></span>
        </div>
        <div class="facility-location"><%= room.building || 'Building not specified' %><%= room.floor ? ` · Floor ${room.floor}` : '' %></div>
      </article>
    <% }) %>
  </div>

  <div class="empty-state card hidden" id="noFacilityResults"><h2>No matching facilities</h2><p>Change the search or filter and try again.</p></div>
  <nav class="facility-pagination" id="facilityPagination" aria-label="Facility pages">
    <span id="facilityPageSummary" aria-live="polite"></span>
    <div class="facility-page-actions">
      <button type="button" class="secondary" id="facilityPrev" disabled>Previous</button>
      <button type="button" class="secondary" id="facilityNext">Next</button>
    </div>
  </nav>
</section>
<script>
(() => {
  const search = document.getElementById('facilitySearch');
  const college = document.getElementById('collegeFilter');
  const sort = document.getElementById('facilitySort');
  const grid = document.getElementById('facilityGrid');
  const cards = [...grid.querySelectorAll('.facility-card')];
  const count = document.getElementById('facilityResults');
  const empty = document.getElementById('noFacilityResults');
  const pagination = document.getElementById('facilityPagination');
  const summary = document.getElementById('facilityPageSummary');
  const previous = document.getElementById('facilityPrev');
  const next = document.getElementById('facilityNext');
  const pageSize = 9;
  let page = 1;
  let filtered = cards.slice();

  const compare = (a, b, key) => (a.dataset[key] || '').localeCompare(b.dataset[key] || '', undefined, {numeric:true, sensitivity:'base'});
  function update() {
    const term = search.value.trim().toLocaleLowerCase();
    filtered = cards.filter(card =>
      (college.value === 'all' || card.dataset.college === college.value) &&
      (!term || card.dataset.search.includes(term))
    );

    switch (sort.value) {
      case 'college': filtered.sort((a,b) => compare(a,b,'collegeName') || compare(a,b,'name')); break;
      case 'capacity-desc': filtered.sort((a,b) => Number(b.dataset.capacity) - Number(a.dataset.capacity) || compare(a,b,'name')); break;
      case 'capacity-asc': filtered.sort((a,b) => Number(a.dataset.capacity) - Number(b.dataset.capacity) || compare(a,b,'name')); break;
      case 'type': filtered.sort((a,b) => compare(a,b,'type') || compare(a,b,'name')); break;
      default: filtered.sort((a,b) => compare(a,b,'name'));
    }

    const total = filtered.length;
    const pages = Math.max(1, Math.ceil(total / pageSize));
    page = Math.min(page, pages);
    const start = (page - 1) * pageSize;
    const visible = new Set(filtered.slice(start, start + pageSize));
    cards.forEach(card => {
      card.classList.toggle('hidden', !visible.has(card));
      if (visible.has(card)) grid.appendChild(card);
    });

    count.textContent = `${total} ${total === 1 ? 'facility' : 'facilities'}`;
    empty.classList.toggle('hidden', total !== 0);
    pagination.classList.toggle('hidden', total <= pageSize);
    summary.textContent = total ? `Showing ${start + 1}–${Math.min(start + pageSize, total)} of ${total}` : 'No results';
    previous.disabled = page <= 1;
    next.disabled = page >= pages;
  }

  search.addEventListener('input', () => { page = 1; update(); });
  college.addEventListener('change', () => { page = 1; update(); });
  sort.addEventListener('change', () => { page = 1; update(); });
  previous.addEventListener('click', () => { if (page > 1) { page--; update(); } });
  next.addEventListener('click', () => { page++; update(); });
  update();
})();
</script>
