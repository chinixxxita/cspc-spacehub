<section class="auth-card register-card" data-motion="login-card">
  <div class="auth-heading">
    <div class="brand-mark">SH</div>
    <div>
      <h1>Create your account</h1>
      <p class="muted">CSPC SpaceHub</p>
    </div>
  </div>

  <form action="/register" method="post" class="register-form"><input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <div class="two-col">
      <div>
        <label for="school_id">Official ID</label>
        <input id="school_id" name="school_id" type="text" placeholder="Student / Faculty ID" autocomplete="username" value="<%= form?.school_id || '' %>" required>
      </div>
      <div>
        <label for="full_name">Full Name</label>
        <input id="full_name" name="full_name" autocomplete="name" value="<%= form?.full_name || '' %>" required>
      </div>
    </div>

    <label for="email">CSPC Email</label>
    <input id="email" type="email" name="email" placeholder="name@cspc.edu.ph" autocomplete="email" value="<%= form?.email || '' %>" required>

    <div class="two-col">
      <div>
        <label for="college_id">College</label>
        <select id="college_id" name="college_id" required>
          <option value="">Select your college</option>
          <% (colleges || []).forEach(c => { %>
            <option value="<%= c.id %>" title="<%= c.name %>" <%= String(form?.college_id || '') === String(c.id) ? 'selected' : '' %>><%= c.code %> — <%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="role">Account Type</label>
        <select id="role" name="role">
          <option value="student" <%= form?.role === 'student' ? 'selected' : '' %>>Student</option>
          <option value="faculty" <%= form?.role === 'faculty' ? 'selected' : '' %>>Faculty / Instructor</option>
        </select>
      </div>
    </div>

    <div class="two-col">
      <div>
        <label for="password">Password</label>
        <input id="password" type="password" name="password" minlength="8" required autocomplete="new-password">
      </div>
      <div>
        <label for="confirm_password">Confirm Password</label>
        <input id="confirm_password" type="password" name="confirm_password" minlength="8" required autocomplete="new-password">
      </div>
    </div>
    <p class="field-hint">At least 8 characters. Use your official CSPC ID and email.</p>

    <label class="terms-check">
      <input type="checkbox" name="terms_accepted" value="on" <%= form?.terms_accepted ? 'checked' : '' %> required>
      <span>I agree to the <a href="/terms" target="_blank" rel="noopener">Terms and Conditions</a> of CSPC SpaceHub.</span>
    </label>

    <button class="primary full" type="submit">Create Account</button>
  </form>

  <p class="muted center">Already registered? <a href="/login">Sign in</a></p>
</section>
