PORT=3000
# Set to production on the host. This also turns on trust proxy, Secure cookies and DB TLS.
NODE_ENV=development

# Local XAMPP can use root temporarily. For deployment, use the dedicated
# least-privilege account created by database/least-privilege.sql.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cspc_spacehub
DB_SSL=false
# DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_SSL_REJECT_UNAUTHORIZED=true

# Only enable AUTO_MIGRATE=true during local development if the DB account
# is allowed to alter tables. Keep it false for the least-privilege account.
AUTO_MIGRATE=false

# Use a long random value (32+ characters) outside development.
SESSION_SECRET=change_this_to_a_long_random_secret_at_least_32_characters

# --- Email notifications (optional; leave SMTP_HOST empty to disable) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
#        SMTP_PASS=<a Google "App password", not your normal password>
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER/SMTP_PASS from Brevo SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CSPC SpaceHub <your@gmail.com>
# Public address of the site, used for the "Open in SpaceHub" button in emails.
APP_URL=http://localhost:3000

# Accounts and email notifications are limited to these domains (comma-separated).
ALLOWED_EMAIL_DOMAINS=cspc.edu.ph

# School-local time zone used for check-in windows, "already started" checks and displayed times.
APP_TIMEZONE=Asia/Manila
